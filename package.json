{
  "name": "opencode-orchestrator",
  "version": "0.2.0",
  "description": "Pinned OpenCode orchestrator session that spawns worker sessions and tracks their status",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:tui": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "check": "bun run build:tui && bun run --bun typecheck && bun run test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/bun": "^1.4.1",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  }
}
